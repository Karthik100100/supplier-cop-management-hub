# ---------------------------------------------------------------------------
# Supplier CoP Management Hub — environment template
#
# Local development:
#   cp .env.example .env.local   and fill in the two values below.
#
# GitHub Pages deployment:
#   add the same two names as repository secrets
#   (Settings → Secrets and variables → Actions → New repository secret).
#   The workflow in .github/workflows/deploy.yml injects them at build time.
#
# Find both values in the Supabase dashboard for the project
# "supplier-cop-hub-demo" under Project Settings → API.
# ---------------------------------------------------------------------------

# Project REST/Auth endpoint, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Public anon (publishable) key. Safe to ship in a browser bundle: every table
# is locked down by Row Level Security, so it grants no access on its own.
# Never put the service_role key here.
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"

# Optional. Defaults to '/supplier-cop-management-hub/' to match the repo name
# on GitHub Pages. Set to '/' when serving from a domain root.
# VITE_BASE_PATH="/"
